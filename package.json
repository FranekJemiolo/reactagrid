{
  "name": "reactagrid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "2D falling sand cellular automata chemistry sandbox and game powered by real-world chemical data",
  "homepage": "https://FranekJemiolo.github.io/reactagrid",
  "repository": {
    "type": "git",
    "url": "https://github.com/FranekJemiolo/reactagrid.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css,yaml,yml}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "stress-test": "npx tsx scripts/stress_test.ts",
    "pipeline": "python3 data-pipeline/extract_chemistry.py",
    "pipeline:validate": "python3 data-pipeline/validate_schema.py"
  },
  "dependencies": {
    "idb": "^8.0.2",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "postcss": "^8.5.28",
    "prettier": "^3.5.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.6",
    "workbox-window": "^7.3.0"
  }
}
